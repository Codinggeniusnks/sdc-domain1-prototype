run = "python src/main.py"
entrypoint = "src/main.py"
modules = ["python-3.11"]

[nix]
channel = "stable-24_05"

[env]
PORT = "5000"
HOST = "0.0.0.0"
PYTHONUNBUFFERED = "1"

[deployment]
deploymentTarget = "autoscale"
run = ["sh", "-c", "python src/main.py"]

[[ports]]
localPort = 5000
externalPort = 80
